# WeatherGPT — Environment Variables
# Do NOT commit real secrets. Copy this file to .env and fill in values via your deployment pipeline.
# Frontend talks ONLY to your backend proxy; never put upstream API keys directly in the frontend bundle.

# Backend proxy URLs — frontend will fetch from these. Leave blank to show honest "data unavailable" states.
VITE_WEATHER_API_URL=
VITE_WEATHER_API_KEY=
VITE_MAP_API_URL=
VITE_MAP_API_KEY=
VITE_CLIMATE_API_URL=

# Example:
# VITE_WEATHER_API_URL=https://api.your-backend.example.com/weather
# VITE_MAP_API_URL=https://api.your-backend.example.com/maps
